{
  "name": "dust-concentration-calculator",
  "version": "1.0.0",
  "author": "yezi",
  "description": "粉尘浓度计算器 - 基于Electron的桌面应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "element-plus": "^2.6.1",
    "@element-plus/icons-vue": "^2.3.1",
    "sql.js": "^1.10.3",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.0.6",
    "typescript": "^5.4.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "vitest": "^1.4.0",
    "@types/node": "^20.11.24",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0"
  },
  "build": {
    "appId": "com.dust-calculator.app",
    "productName": "粉尘浓度计算器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    }
  }
}